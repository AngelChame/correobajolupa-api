# PROVISIONAL: se ajusta al crear el backend. Copia este archivo a .env y cambia los valores.
# Nunca subas el .env real. Todos los valores de abajo son de ejemplo.

# NODE_ENV no va aquí: el Compose lo fija en production.
LOG_LEVEL=info

# Puerto de la API en tu máquina (dentro del contenedor siempre es 3000)
API_PORT=3000

# Base de datos. El Compose arma DATABASE_URL con estos valores.
# Usa solo letras y números en la contraseña (va dentro de una URL).
POSTGRES_DB=correobajolupa
POSTGRES_USER=correobajolupa
POSTGRES_PASSWORD=cambiar

# Cookie de sesión: Secure siempre en el Compose (NODE_ENV=production no arranca con false).
# Los navegadores aceptan cookies Secure en http://localhost y http://127.0.0.1.
COOKIE_SECURE=true

# Primer administrador: se crea al arrancar si las dos tienen valor y no hay ningún admin.
# Déjalas vacías si no lo necesitas. Contraseña de 12 a 128 caracteres; no la reutilices.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# Código de invitación (D-010). Vacío: registro abierto. Con valor: obligatorio al registrarse.
INVITE_CODE=

# Límites de peticiones (vacíos = valores por defecto: registro 10 por hora por IP;
# login 30 cada 15 min por IP y 5 fallos cada 15 min por correo; global 300 por minuto por IP
# en toda la API salvo /health). Sin proxy todos comparten la IP del puente de Docker.
RATE_LIMIT_REGISTER_PER_IP=
RATE_LIMIT_REGISTER_WINDOW_MIN=
RATE_LIMIT_LOGIN_PER_IP=
RATE_LIMIT_LOGIN_FAILS_PER_EMAIL=
RATE_LIMIT_LOGIN_WINDOW_MIN=
RATE_LIMIT_GLOBAL_PER_MINUTE=

# --- Lo de abajo todavía no lo usa la API: el Compose no lo pasa al contenedor ---

# Cola (llega en M1)
REDIS_URL=redis://redis:6379

# Dominios institucionales para la regla 3 y la lista de exclusión (separados por comas)
INSTITUTIONAL_DOMAINS=ejemplo.invalid

# Archivos (.eml y adjuntos): carpeta del volumen
STORAGE_DIR=/data/storage

# Retención de reportes en días
RETENTION_DAYS=7

# ClamAV
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Servidor IMAP de laboratorio (solo accesible dentro de la red de Docker)
IMAP_LAB_HOST=imap
IMAP_LAB_PORT=993
IMAP_LAB_PASSWORD=cambiar
