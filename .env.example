# PROVISIONAL: se ajusta al crear el backend. Copia este archivo a .env y cambia los valores.
# Nunca subas el .env real. Todos los valores de abajo son de ejemplo.

# NODE_ENV no va aquí: el Compose lo fija en production.
LOG_LEVEL=info

# Puerto de la API en tu máquina (dentro del contenedor siempre es 3000)
API_PORT=3000

# Base de datos. El Compose arma DATABASE_URL con estos valores.
# Usa solo letras y números en la contraseña (va dentro de una URL).
POSTGRES_DB=correobajolupa
POSTGRES_USER=correobajolupa
POSTGRES_PASSWORD=cambiar

# Cookie de sesión: Secure siempre en el Compose (NODE_ENV=production no arranca con false).
# Los navegadores aceptan cookies Secure en http://localhost y http://127.0.0.1.
COOKIE_SECURE=true

# Primer administrador: se crea al arrancar si las dos tienen valor y no hay ningún admin.
# Déjalas vacías si no lo necesitas. Contraseña de 12 a 128 caracteres; no la reutilices.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# Código de invitación (D-010). Vacío: registro abierto. Con valor: obligatorio al registrarse.
INVITE_CODE=

# Límites de peticiones (vacíos = valores por defecto: registro 10 por hora por IP;
# login 30 cada 15 min por IP y 5 fallos cada 15 min por correo; global 300 por minuto por IP
# en toda la API salvo /health). Sin proxy todos comparten la IP del puente de Docker.
RATE_LIMIT_REGISTER_PER_IP=
RATE_LIMIT_REGISTER_WINDOW_MIN=
RATE_LIMIT_LOGIN_PER_IP=
RATE_LIMIT_LOGIN_FAILS_PER_EMAIL=
RATE_LIMIT_LOGIN_WINDOW_MIN=
RATE_LIMIT_GLOBAL_PER_MINUTE=

# Proxy inverso: número de saltos de confianza para la IP del cliente. 0 = sin proxy.
# Con el front (perfil web, nginx delante de la API) se pone 1. Solo números: "true" no se acepta.
TRUST_PROXY_HOPS=0

# Front (perfil web): puerto en tu máquina y carpeta del repo de Cesar (por defecto, al lado).
WEB_PORT=8080
WEB_REPO_DIR=../correobajolupa-web

# --- M1: reportes (vacíos = valores por defecto de src/config.ts) ---

# Tamaño máximo en bytes: .eml 10 MiB (10485760) y texto pegado 1 MiB (1048576).
MAX_EML_BYTES=
MAX_PASTE_BYTES=
# Reportes por cuenta por hora (30 por defecto).
REPORTS_PER_USER_PER_HOUR=
# Dominios institucionales para la regla 3, separados por comas (sin esquema ni rutas).
INSTITUTIONAL_DOMAINS=universidad-ejemplo.example
# Cola en PostgreSQL (D-054): espera entre búsquedas del worker (ms, 1000), arriendo de un
# reporte (s, 120) e intentos antes de marcarlo failed (3).
WORKER_POLL_MS=
JOB_LEASE_SECONDS=
JOB_MAX_ATTEMPTS=
# Limpieza programada del worker (minutos, 60): reportes vencidos, sesiones vencidas y carpetas huérfanas.
CLEANUP_INTERVAL_MIN=
# Feeds de reputación (opcionales; apagados por defecto). Solo uso académico autorizado.
# OpenPhish restringe la redistribución y exige capacidad legal: solo activar con autorización
# institucional y condiciones de uso verificadas. No activar por defecto en una demo pública.
OPENPHISH_FEED_ENABLED=false
# URLhaus requiere una Auth-Key propia; nunca la compartas ni la subas a GitHub.
URLHAUS_AUTH_KEY=
FEED_REFRESH_HOURS=
# API pública de VirusTotal: opcional, solo en el worker. Sin clave no se consulta.
# No compartas la clave ni la subas al repositorio. La conexión al worker aún está pendiente.
VIRUSTOTAL_API_KEY=
# Carpeta de los archivos de reportes (D-038). En el Compose es fija (/data/reports, volumen
# reports-data) y esta variable no se usa; solo sirve al correr la API fuera de Docker.
STORAGE_DIR=/data/reports

# --- M2: adjuntos y ClamAV (solo el worker; vacíos = valores por defecto de src/config.ts) ---

# En el Compose el host y el puerto son fijos (clamav:3310, red clamav-net); estas dos variables
# solo sirven al correr el worker fuera de Docker.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Tiempo máximo de un escaneo (ms, 10000) y de todos los de un reporte (ms, 20000). El total no
# puede pasar de JOB_LEASE_SECONDS * 1000 / 2. Lo que no alcance queda en error, nunca limpio.
CLAMAV_TIMEOUT_MS=
CLAMAV_TOTAL_BUDGET_MS=
# Adjuntos más grandes que esto (bytes, 10 MiB) no se escanean: quedan unsupported.
CLAMAV_MAX_SCAN_BYTES=
# Se escanean los primeros N adjuntos de cada reporte (20; se registran hasta 50).
MAX_ATTACHMENTS_SCANNED=

# --- M4: servidor IMAP del laboratorio (Dovecot, D-043) ---

# Contraseña de los tres buzones (student, teacher y staff @lab.example). Al menos 16 caracteres.
# Sin ella o con "cambiar", el contenedor imap se niega a arrancar y las rutas del laboratorio
# responden 503; el resto de la pila (modo real) funciona igual. Dovecot solo guarda su hash.
# Nunca la reutilices.
IMAP_LAB_PASSWORD=cambiar
# Puerto 143 sin TLS, solo dentro de la red imap-net de Docker (no se publica al host).
# En el Compose host y puerto son fijos (imap:143); estas dos solo sirven al correr fuera de Docker.
IMAP_LAB_HOST=imap
IMAP_LAB_PORT=143
# Sincronización de un buzón (vacíos = valores por defecto): mensajes como mucho por buzón (500)
# y tiempo máximo en ms (45000; hasta 55000, por debajo de los 60 s del proxy).
SYNC_MAX_MESSAGES=
SYNC_BUDGET_MS=
