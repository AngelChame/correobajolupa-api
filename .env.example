# PROVISIONAL: se ajusta al crear el backend. Copia este archivo a .env y cambia los valores.
# Nunca subas el .env real. Todos los valores de abajo son de ejemplo.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Base de datos y cola
DATABASE_URL=postgresql://usuario:cambiar@db:5432/correobajolupa
REDIS_URL=redis://redis:6379

# Cookies de sesión: solo en desarrollo local se puede poner false (en producción siempre true)
COOKIE_SECURE=true

# Primer administrador (sale de la configuración de despliegue)
FIRST_ADMIN_EMAIL=admin@ejemplo.invalid
FIRST_ADMIN_PASSWORD=cambiar-esta-contrasena

# Dominios institucionales para la regla 3 y la lista de exclusión (separados por comas)
INSTITUTIONAL_DOMAINS=ejemplo.invalid

# Archivos (.eml y adjuntos): carpeta del volumen
STORAGE_DIR=/data/storage

# Retención de reportes en días
RETENTION_DAYS=7

# ClamAV
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Servidor IMAP de laboratorio (solo accesible dentro de la red de Docker)
IMAP_LAB_HOST=imap
IMAP_LAB_PORT=993
IMAP_LAB_PASSWORD=cambiar
