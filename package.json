{
  "name": "correobajolupa-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de CorreoBajoLupa: análisis explicable de correos sospechosos.",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "contract:generate": "tsx src/contract/generate.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "effect": "3.22.4"
  }
}
