// Modelo de datos de CorreoBajoLupa (M0: cuentas, sesiones y auditoría; M1: reportes; M2:
// adjuntos; M4: laboratorio IMAP; M5: indicadores y lista de exclusión; M6: incidentes; M7:
// acciones de cuarentena y restauración).
// Nombres en inglés en el código (D-044); tablas y columnas en snake_case en la base.
// La URL de conexión no va aquí: la lee prisma.config.ts (CLI) y src/db/client.ts (app).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  reporter
  analyst
  admin

  @@map("user_role")
}

enum AuditResult {
  success
  failure
  denied

  @@map("audit_result")
}

// Enums de reportes: mismos valores que src/contract/schemas/reports.ts
// (test/prisma-enums.test.ts falla si se separan).

enum ReportStatus {
  queued
  processing
  completed
  limited
  failed

  @@map("report_status")
}

enum ReportSource {
  eml
  paste

  @@map("report_source")
}

enum Priority {
  low
  medium
  high

  @@map("report_priority")
}

enum LimitedReason {
  missing_headers
  parse_error

  @@map("limited_reason")
}

enum RuleId {
  R1
  R2
  R3
  R4
  R5
  R6
  R7
  R8

  @@map("rule_id")
}

// Mismos valores que ScanStatus en src/contract/schemas/attachments.ts (D-018).
enum ScanStatus {
  not_detected
  detected
  unsupported
  error

  @@map("scan_status")
}

/// Cuenta de la plataforma. El email se guarda siempre en minúsculas
/// (normalizeEmail en src/db/email.ts y un CHECK en la migración), así
/// el índice único impide duplicados que solo cambian en mayúsculas.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  /// Nombre para mostrar (contrato: 1 a 80 caracteres). Se escapa siempre al mostrarlo.
  displayName  String   @map("display_name") @db.VarChar(80)
  /// Hash Argon2id (M0, paso 3). Nunca la contraseña.
  passwordHash String   @map("password_hash")
  role         Role     @default(reporter)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions           Session[]
  auditEvents        AuditEvent[]
  reports            Report[]
  proposedIndicators Indicator[]         @relation("IndicatorProposedBy")
  decidedIndicators  Indicator[]         @relation("IndicatorDecidedBy")
  exclusions         Exclusion[]
  createdIncidents   Incident[]
  incidentReports    IncidentReport[]
  incidentIndicators IncidentIndicator[]
  incidentComments   IncidentComment[]
  quarantineActions  QuarantineAction[]

  @@map("users")
}

/// Sesión (D-034). La cookie lleva un token aleatorio; aquí solo se guarda su hash,
/// así que leer esta tabla no da sesiones utilizables.
model Session {
  id             String   @id @default(uuid()) @db.Uuid
  /// Hash del token de la cookie. Nunca el token.
  tokenHash      String   @unique @map("token_hash") @db.VarChar(128)
  userId         String   @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Token CSRF de la sesión (se devuelve en GET /auth/me; solo sirve junto con la cookie).
  csrfToken      String   @map("csrf_token") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Para el vencimiento por inactividad.
  lastActivityAt DateTime @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  /// Vencimiento absoluto; la limpieza de sesiones vencidas filtra por aquí.
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Evento de auditoría (D-036). Se enlaza con los registros técnicos por requestId.
/// Los eventos sin petición HTTP (arranque, tareas programadas) no llevan requestId
/// y usan acciones con prefijo "system." (D-047).
/// NUNCA se guardan aquí cuerpos ni asuntos de correos, contraseñas, tokens, cookies
/// ni otros secretos: ni en columnas ni dentro de metadata.
model AuditEvent {
  id         String      @id @default(uuid()) @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  requestId  String?     @map("request_id") @db.VarChar(64)
  /// Quién hizo la acción. Si la cuenta se borra, el evento se conserva con actor nulo.
  actorId    String?     @map("actor_id") @db.Uuid
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Acción corta y estable, por ejemplo "auth.login", "user.role_change" o "system.bootstrap_admin".
  action     String      @db.VarChar(64)
  targetType String?     @map("target_type") @db.VarChar(32)
  targetId   String?     @map("target_id") @db.VarChar(64)
  result     AuditResult
  /// Datos extra no sensibles (IDs, rol anterior y nuevo, motivo de un rechazo).
  metadata   Json?

  @@index([createdAt])
  @@index([actorId])
  @@map("audit_events")
}

/// Reporte de un correo (modo real). Es también la cola de análisis (D-054): el worker toma
/// filas `queued` (o `processing` con el arriendo vencido) y las bloquea con lockedUntil.
/// El archivo original vive en el almacenamiento (D-038); aquí solo su clave, tamaño y SHA-256.
/// subject y fromAddress son texto del correo: se escapan siempre y nunca van a los registros.
model Report {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         ReportStatus   @default(queued)
  source         ReportSource
  subject        String?
  fromAddress    String?        @map("from_address")
  /// Nula mientras no termine el análisis.
  priority       Priority?
  /// Solo con status = limited (CHECK en la migración).
  limitedReason  LimitedReason? @map("limited_reason")
  rulesVersion   String?        @map("rules_version") @db.VarChar(32)
  analyzedAt     DateTime?      @map("analyzed_at") @db.Timestamptz(3)
  hasHtml        Boolean        @default(false) @map("has_html")
  /// SPF, DKIM y DMARC como información (D-016): { spf, dkim, dmarc }. Nunca suman puntaje.
  authentication Json?
  /// Clave que devuelve el almacenamiento (carpeta del reporte / nombre aleatorio). Nunca una ruta ni el nombre del adjunto.
  storageKey     String         @map("storage_key") @db.VarChar(128)
  sizeBytes      Int            @map("size_bytes")
  /// SHA-256 en hexadecimal de los bytes guardados.
  sha256         String         @db.Char(64)
  createdAt      DateTime       @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)
  /// Retención de 7 días (D-012). createdAt y expiresAt los calcula la base con la misma hora
  /// de la transacción, así expiresAt - createdAt es exactamente 7 días.
  expiresAt      DateTime       @default(dbgenerated("(transaction_timestamp() + '7 days'::interval)")) @map("expires_at") @db.Timestamptz(3)

  // Cola (D-054)
  attempts      Int       @default(0)
  /// Arriendo del worker: mientras sea futuro, ningún otro worker toma la fila.
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  /// Código corto del último error (p. ej. "parse_timeout"). Nunca el mensaje ni contenido del correo.
  lastErrorCode String?   @map("last_error_code") @db.VarChar(64)

  findings    Finding[]
  links       ReportLink[]
  attachments Attachment[]
  indicators  Indicator[]
  incidents   IncidentReport[]

  @@index([status, lockedUntil])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("reports")
}

/// Hallazgo de una regla. Solo inserción: un trigger de la migración rechaza los UPDATE
/// (los hallazgos nunca se sobrescriben); se borran solo junto con su reporte.
model Finding {
  id           String   @id @default(uuid()) @db.Uuid
  reportId     String   @map("report_id") @db.Uuid
  report       Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  ruleId       RuleId   @map("rule_id")
  ruleName     String   @map("rule_name") @db.VarChar(120)
  summary      String
  /// Lista [{ label, value }] (EvidenceItem del contrato). Enlaces y dominios ya desactivados.
  evidence     Json
  rulesVersion String   @map("rules_version") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([reportId])
  @@map("findings")
}

/// Enlace extraído del cuerpo. Nunca se visita (D-017).
model ReportLink {
  id            String  @id @default(uuid()) @db.Uuid
  reportId      String  @map("report_id") @db.Uuid
  report        Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Orden de aparición en el correo, desde 0.
  position      Int
  /// Texto visible del enlace (texto del correo: se escapa siempre).
  displayText   String? @map("display_text")
  /// URL normalizada sin query ni fragmento.
  normalizedUrl String  @map("normalized_url")
  /// Forma desactivada para mostrar, por ejemplo hxxp://dominio[.]com.
  defangedUrl   String  @map("defanged_url")
  domain        String? @db.VarChar(253)

  @@unique([reportId, position])
  @@map("report_links")
}

/// Adjunto de un reporte (M2). Solo metadatos: los bytes NO se guardan en ningún lado; el worker
/// los extrae del .eml en memoria, calcula el SHA-256 y los manda a ClamAV. Nunca se ejecutan
/// ni se descomprimen (D-018).
model Attachment {
  id           String     @id @default(uuid()) @db.Uuid
  reportId     String     @map("report_id") @db.Uuid
  report       Report     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Orden en el correo, desde 0.
  position     Int
  /// Nombre saneado (sin caracteres de control ni de dirección de texto). Texto hostil: se escapa
  /// siempre, nunca se usa como ruta y nunca va a los registros.
  fileName     String?    @map("file_name") @db.VarChar(255)
  /// Content-Type declarado en el correo.
  declaredType String?    @map("declared_type") @db.VarChar(255)
  /// Tipo detectado por los primeros bytes (por ejemplo "application/pdf").
  detectedType String?    @map("detected_type") @db.VarChar(64)
  sizeBytes    Int        @map("size_bytes")
  /// SHA-256 en hexadecimal del contenido decodificado.
  sha256       String     @db.Char(64)
  scanStatus   ScanStatus @map("scan_status")
  /// Firma detectada, o motivo de unsupported o error.
  scanDetail   String?    @map("scan_detail") @db.VarChar(200)
  /// Cuándo respondió ClamAV; null si no se llegó a escanear.
  scannedAt    DateTime?  @map("scanned_at") @db.Timestamptz(3)

  @@unique([reportId, position])
  @@map("attachments")
}

// ---------------------------------------------------------------------------------------------
// M4: laboratorio IMAP (D-015, D-007, D-008). Mismos valores que src/contract/schemas/lab.ts
// (test/prisma-enums.test.ts falla si se separan).

enum MailboxLabel {
  student
  teacher
  staff

  @@map("mailbox_label")
}

enum SyncStatus {
  ok
  error
  never

  @@map("sync_status")
}

enum MessageLocation {
  inbox
  quarantine

  @@map("message_location")
}

/// Buzón del laboratorio. Las 3 filas las inserta la migración (no hay arranque que las cree).
model Mailbox {
  id             String       @id @default(uuid()) @db.Uuid
  label          MailboxLabel @unique
  address        String       @unique @db.VarChar(254)
  lastSyncAt     DateTime?    @map("last_sync_at") @db.Timestamptz(3)
  lastSyncStatus SyncStatus   @default(never) @map("last_sync_status")
  /// Arriendo de la sincronización (como la cola, D-054): mientras sea reciente, nadie más sincroniza este buzón.
  syncStartedAt  DateTime?    @map("sync_started_at") @db.Timestamptz(3)

  messages          IndexedMessage[]
  quarantineActions QuarantineAction[]

  @@map("mailboxes")
}

/// Copia indexada de un mensaje de un buzón del laboratorio (no es un reporte). Sin bytes del
/// correo: solo lo que el analizador extrajo. subject, fromAddress y replyTo son texto del correo:
/// se escapan siempre y nunca van a los registros.
model IndexedMessage {
  id             String          @id @default(uuid()) @db.Uuid
  mailboxId      String          @map("mailbox_id") @db.Uuid
  mailbox        Mailbox         @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  /// RF-07: Message-ID normalizado o "sha256:" + SHA-256 del crudo. Mover el mensaje no lo cambia.
  dedupeKey      String          @map("dedupe_key")
  location       MessageLocation
  /// UID y UIDVALIDITY son enteros de 32 bits sin signo: BIGINT en la base.
  uid            BigInt
  uidValidity    BigInt          @map("uid_validity")
  subject        String?
  fromAddress    String?         @map("from_address")
  replyTo        String[]        @default([]) @map("reply_to")
  /// Fecha del encabezado Date.
  date           DateTime?       @db.Timestamptz(3)
  hasAttachments Boolean         @map("has_attachments")
  linksCount     Int             @map("links_count")
  authentication Json?
  rulesVersion   String          @map("rules_version") @db.VarChar(32)
  priority       Priority
  /// Reglas que disparó el analizador (sin evidencia: esa vive en los reportes).
  ruleIds        RuleId[]        @default([]) @map("rule_ids")
  indexedAt      DateTime        @default(now()) @map("indexed_at") @db.Timestamptz(3)

  links       IndexedMessageLink[]
  attachments IndexedMessageAttachment[]

  @@unique([mailboxId, dedupeKey])
  @@unique([mailboxId, location, uidValidity, uid])
  @@map("indexed_messages")
}

/// Enlace de un mensaje indexado (como report_links). Nunca se visita (D-017).
model IndexedMessageLink {
  id            String         @id @default(uuid()) @db.Uuid
  messageId     String         @map("message_id") @db.Uuid
  message       IndexedMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  position      Int
  displayText   String?        @map("display_text")
  normalizedUrl String         @map("normalized_url")
  defangedUrl   String         @map("defanged_url")
  domain        String?        @db.VarChar(253)

  @@unique([messageId, position])
  @@index([domain])
  @@index([normalizedUrl])
  @@map("indexed_message_links")
}

/// Adjunto de un mensaje indexado (como attachments): solo metadatos, nunca los bytes (D-056.1).
/// Al sincronizar no se escanea: scanStatus = unsupported, nunca "limpio" (D-018).
model IndexedMessageAttachment {
  id           String         @id @default(uuid()) @db.Uuid
  messageId    String         @map("message_id") @db.Uuid
  message      IndexedMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  position     Int
  fileName     String?        @map("file_name") @db.VarChar(255)
  declaredType String?        @map("declared_type") @db.VarChar(255)
  detectedType String?        @map("detected_type") @db.VarChar(64)
  sizeBytes    Int            @map("size_bytes")
  sha256       String         @db.Char(64)
  scanStatus   ScanStatus     @map("scan_status")
  scanDetail   String?        @map("scan_detail") @db.VarChar(200)
  scannedAt    DateTime?      @map("scanned_at") @db.Timestamptz(3)

  @@unique([messageId, position])
  @@index([sha256])
  @@map("indexed_message_attachments")
}

enum IndicatorType {
  domain
  url
  sha256
  sender

  @@map("indicator_type")
}

enum IndicatorStatus {
  proposed
  confirmed
  dismissed

  @@map("indicator_status")
}

/// Indicador (M5, D-019): dominio, URL, SHA-256 o remitente que sirve para buscar candidatos.
/// value se guarda ya normalizado; la API solo lo devuelve desactivado (D-017) y nunca va a los
/// registros ni a la auditoría. Único por (type, value) solo entre los no descartados: índice
/// parcial en la migración (Prisma no lo expresa sin una función en vista previa).
model Indicator {
  id           String          @id @default(uuid()) @db.Uuid
  type         IndicatorType
  value        String          @db.VarChar(2048)
  status       IndicatorStatus @default(proposed)
  /// Reporte desde el que se propuso. Si el reporte se borra (7 días), el indicador se conserva.
  reportId     String?         @map("report_id") @db.Uuid
  report       Report?         @relation(fields: [reportId], references: [id], onDelete: SetNull)
  proposedById String          @map("proposed_by_id") @db.Uuid
  proposedBy   User            @relation("IndicatorProposedBy", fields: [proposedById], references: [id], onDelete: Restrict)
  decidedById  String?         @map("decided_by_id") @db.Uuid
  decidedBy    User?           @relation("IndicatorDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  /// Nota de quien propone (texto libre: se escapa siempre y no va a los registros).
  note         String?         @db.VarChar(500)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt    DateTime?       @map("decided_at") @db.Timestamptz(3)

  incidents IncidentIndicator[]

  @@index([proposedById, createdAt])
  @@index([status, createdAt])
  @@map("indicators")
}

/// Dominio de la lista de exclusión (P-11): no se puede proponer ni confirmar un indicador que
/// caiga en él ni en sus subdominios. Los dominios institucionales de la configuración también
/// excluyen, pero no viven aquí (se muestran como solo lectura).
model Exclusion {
  id          String   @id @default(uuid()) @db.Uuid
  /// Normalizado (minúsculas, punycode, sin punto final).
  domain      String   @unique @db.VarChar(253)
  reason      String?  @db.VarChar(500)
  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("exclusions")
}

// ---------------------------------------------------------------------------------------------
// M6: incidentes y comentarios. Mismos valores que IncidentStatus en
// src/contract/schemas/incidents.ts (test/prisma-enums.test.ts falla si se separan).

enum IncidentStatus {
  received
  analyzing
  contained
  closed
  false_positive

  @@map("incident_status")
}

/// Incidente: agrupa reportes, indicadores y comentarios de una investigación. title y
/// description son texto de usuario: se guardan tal cual, se escapan siempre al mostrarlos y
/// nunca van a los registros ni a la auditoría (P-18). Las transiciones de estado viven en
/// src/incidents/status.ts. updatedAt lo pone la ruta (un PATCH sin cambios no lo toca).
model Incident {
  id          String         @id @default(uuid()) @db.Uuid
  title       String         @db.VarChar(120)
  description String?        @db.VarChar(2000)
  status      IncidentStatus @default(received)
  /// Quien lo creó. Restrict: una cuenta con incidentes no se puede borrar (solo desactivar).
  createdById String         @map("created_by_id") @db.Uuid
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  reports    IncidentReport[]
  indicators IncidentIndicator[]
  comments   IncidentComment[]
  actions    QuarantineAction[]

  @@index([status, updatedAt])
  @@index([updatedAt])
  @@map("incidents")
}

/// Reporte asociado a un incidente. Al borrar el reporte (retención de 7 días, D-012) se borra
/// la asociación y el incidente se queda; al borrar el incidente, también.
model IncidentReport {
  incidentId String   @map("incident_id") @db.Uuid
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  reportId   String   @map("report_id") @db.Uuid
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  addedById  String   @map("added_by_id") @db.Uuid
  addedBy    User     @relation(fields: [addedById], references: [id], onDelete: Restrict)
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  // La llave primaria (incident_id, report_id) también sirve de índice por incident_id.
  @@id([incidentId, reportId])
  @@index([reportId])
  @@map("incident_reports")
}

/// Indicador asociado a un incidente (cualquier estado: M7 decide cuáles usa).
model IncidentIndicator {
  incidentId  String    @map("incident_id") @db.Uuid
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  indicatorId String    @map("indicator_id") @db.Uuid
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  addedById   String    @map("added_by_id") @db.Uuid
  addedBy     User      @relation(fields: [addedById], references: [id], onDelete: Restrict)
  addedAt     DateTime  @default(now()) @map("added_at") @db.Timestamptz(3)

  @@id([incidentId, indicatorId])
  @@index([indicatorId])
  @@map("incident_indicators")
}

/// Comentario de un incidente. Solo inserción: un trigger de la migración rechaza los UPDATE y
/// no hay rutas para editarlos ni borrarlos; se borran solo junto con su incidente. body es texto
/// de usuario: se escapa siempre y nunca va a los registros ni a la auditoría (P-18).
model IncidentComment {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId   String   @map("author_id") @db.Uuid
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body       String   @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([incidentId, createdAt])
  @@map("incident_comments")
}

// ---------------------------------------------------------------------------------------------
// M7: cuarentena y restauración (D-008, D-013). Mismos valores que ActionType y ActionStatus en
// src/contract/schemas/response.ts (test/prisma-enums.test.ts falla si se separan).

enum ActionType {
  quarantine
  restore

  @@map("action_type")
}

enum ActionStatus {
  done
  failed

  @@map("action_status")
}

/// Acción de cuarentena o de restauración sobre un mensaje del laboratorio, aprobada por una
/// persona dentro de un incidente. Única por (incidente, mensaje, tipo): repetir no mueve nada y
/// un intento fallido se reintenta en la misma fila. Guarda la ubicación original y la nueva como
/// fotografía (carpeta, UID y UIDVALIDITY), así la evidencia sobrevive aunque el índice cambie.
/// messageId, mailboxId y dedupeKey son datos propios: SIN clave foránea a indexed_messages, para
/// que la sincronización pueda seguir borrando filas cuando cambia el UIDVALIDITY (D-008).
/// Nunca guarda asunto, remitente, direcciones ni bytes del correo.
model QuarantineAction {
  id                  String           @id @default(uuid()) @db.Uuid
  /// Restrict: un incidente con acciones no se borra (no hay ruta para borrar incidentes).
  incidentId          String           @map("incident_id") @db.Uuid
  incident            Incident         @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  /// Id del mensaje indexado al aprobarlo (sin clave foránea, ver arriba).
  messageId           String           @map("message_id") @db.Uuid
  mailboxId           String           @map("mailbox_id") @db.Uuid
  mailbox             Mailbox          @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  /// Clave de deduplicación del mensaje (RF-07): lo reencuentra en el índice aunque cambie su id.
  dedupeKey           String           @map("dedupe_key")
  type                ActionType
  status              ActionStatus
  originalLocation    MessageLocation  @map("original_location")
  originalUid         BigInt           @map("original_uid")
  originalUidValidity BigInt           @map("original_uid_validity")
  /// Solo con status = done (CHECK): dónde quedó según el COPYUID del servidor.
  newLocation         MessageLocation? @map("new_location")
  newUid              BigInt?          @map("new_uid")
  newUidValidity      BigInt?          @map("new_uid_validity")
  /// Código corto del fallo (p. ej. "uidvalidity_mismatch"). Nunca texto del servidor ni del correo.
  failureCode         String?          @map("failure_code") @db.VarChar(64)
  attempts            Int              @default(1)
  /// Quién la aprobó. Restrict: una cuenta con acciones no se puede borrar (solo desactivar).
  actorId             String           @map("actor_id") @db.Uuid
  actor               User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([incidentId, messageId, type])
  @@index([incidentId, createdAt])
  @@index([mailboxId, dedupeKey])
  @@map("quarantine_actions")
}
